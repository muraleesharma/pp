{
  "name": "pravya-pranavi-birthday",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:local": "tsc -b && vite build --mode local-preview",
    "preview": "vite preview --host 0.0.0.0",
    "share-card": "node scripts/generate-share-card.mjs",
    "format": "prettier --write src vite.config.ts scripts/generate-share-card.mjs index.html invite.html",
    "format:check": "prettier --check src vite.config.ts scripts/generate-share-card.mjs index.html invite.html"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^6.3.5"
  }
}
